<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IPCast.Client.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button:focus-visible">
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}" />
        </Style>

        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SidebarItemSelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#1A1A1A" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#080808" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#0D0D0D" />
        <SolidColorBrush x:Key="CardBrush" Color="#111111" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#292929" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A3A3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentBrushHover" Color="#D4D4D4" />
        <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="#202020" />
    </Application.Resources>
</Application>
