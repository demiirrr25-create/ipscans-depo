<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IPCast.Client.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- ============ IPScans v2 Design System Tokens (Default: Dark) ============ -->
        <SolidColorBrush x:Key="ObsidianBrush" Color="#07080B" />
        <SolidColorBrush x:Key="Surface0Brush" Color="#0D0F14" />
        <SolidColorBrush x:Key="Surface1Brush" Color="#111520" />
        <SolidColorBrush x:Key="Surface2Brush" Color="#171C29" />
        <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#CC0D0F14" />
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#17FFFFFF" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#17FFFFFF" />
        <SolidColorBrush x:Key="HoverBorderBrush" Color="#29FFFFFF" />

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F7FA" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8B0C2" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6E778C" />

        <SolidColorBrush x:Key="AccentBrush" Color="#4C82FF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#6B99FF" />
        <SolidColorBrush x:Key="AccentSubtleBrush" Color="#244C82FF" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryBtnBgBrush" Color="#4C82FF" />
        <SolidColorBrush x:Key="PrimaryBtnFgBrush" Color="#FFFFFF" />

        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />

        <!-- Semantic aliases mapped to IPScans v2 tokens -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#07080B" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#0D0F14" />
        <SolidColorBrush x:Key="CardBrush" Color="#111520" />
        <SolidColorBrush x:Key="CardBrushElevated" Color="#171C29" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#17FFFFFF" />
        <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#29FFFFFF" />
        <SolidColorBrush x:Key="ControlFillBrush" Color="#171C29" />
        <SolidColorBrush x:Key="SubtleFillBrush" Color="#171C29" />
        <SolidColorBrush x:Key="AccentBrushHover" Color="#6B99FF" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#2F6BFF" />
        <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#F87171" />
        <SolidColorBrush x:Key="DangerFillBrush" Color="#24EF4444" />
        <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="#244C82FF" />
        <SolidColorBrush x:Key="StatusOnlineBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="StatusBusyBrush" Color="#F59E0B" />

        <!-- Fluent accent chrome aligned with IPScans Signal Blue -->
        <Color x:Key="SystemAccentColor">#FF4C82FF</Color>
        <Color x:Key="SystemAccentColorLight1">#FF6B99FF</Color>
        <Color x:Key="SystemAccentColorLight2">#FF93B4FF</Color>
        <Color x:Key="SystemAccentColorLight3">#FFBDD2FF</Color>
        <Color x:Key="SystemAccentColorDark1">#FF2F6BFF</Color>
        <Color x:Key="SystemAccentColorDark2">#FF1E56E8</Color>
        <Color x:Key="SystemAccentColorDark3">#FF1D4ED8</Color>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ============ Base window / typography ============ -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{DynamicResource ObsidianBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="TextBlock.display">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="LetterSpacing" Value="1.1" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <!-- ============ Cards ============ -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style Selector="Border.device">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.device:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
        </Style>

        <!-- ============ Buttons ============ -->
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- Primary (IPScans Signal Blue fill, crisp white text) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBtnFgBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryBtnFgBrush}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryBtnFgBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
        </Style>

        <!-- Ghost (borderless) -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Danger -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Button.danger /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerHoverBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerHoverBrush}" />
        </Style>

        <!-- Compact toolbar button -->
        <Style Selector="Button.toolbar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.toolbar /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- ToggleButton -->
        <Style Selector="ToggleButton">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- ============ Inputs ============ -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <!-- ============ Sidebar navigation ============ -->
        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ============ Misc ============ -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
    </Application.Styles>
</Application>
