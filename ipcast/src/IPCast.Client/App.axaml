<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IPCast.Client.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button:focus-visible">
            <Setter Property="BorderBrush" Value="#99F6E4" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="#062B2C" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1220" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#101D30" />
        <SolidColorBrush x:Key="CardBrush" Color="#152338" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#33465F" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8C9DE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5EEAD4" />
        <SolidColorBrush x:Key="AccentBrushHover" Color="#99F6E4" />
        <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="#1F2937" />
    </Application.Resources>
</Application>
