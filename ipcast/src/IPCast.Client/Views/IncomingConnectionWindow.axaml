<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IPCast.Client.Views.IncomingConnectionWindow"
        Title="IPCast — Incoming connection"
        Icon="/Assets/ipcast.ico"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <StackPanel Margin="28" Spacing="18">

        <StackPanel Spacing="4">
            <TextBlock Text="INCOMING CONNECTION" Classes="eyebrow" />
            <TextBlock Text="A device wants to connect" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>

        <Border Classes="device" Padding="16">
            <StackPanel Spacing="6">
                <TextBlock Name="DeviceIdText" FontSize="24" FontWeight="Bold" FontFamily="Consolas, monospace"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Name="RequestTimeText" Classes="hint" />
            </StackPanel>
        </Border>

        <StackPanel Spacing="8">
            <TextBlock Text="ALLOW ONLY WHAT YOU WANT" Classes="eyebrow" />
            <CheckBox Name="ViewScreenCheck" Content="View screen" />
            <CheckBox Name="ControlMouseCheck" Content="Control mouse" />
            <CheckBox Name="ControlKeyboardCheck" Content="Control keyboard" />
            <CheckBox Name="ClipboardCheck" Content="Clipboard sync" />
            <CheckBox Name="FileTransferCheck" Content="File transfer" />
            <CheckBox Name="SystemInfoCheck" Content="System information" IsVisible="False" IsEnabled="False" />
            <CheckBox Name="RemoteRestartCheck" Content="Remote restart" IsVisible="False" IsEnabled="False" />
        </StackPanel>

        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="8" Padding="12">
            <TextBlock Text="This connection is encrypted with TLS. New device certificates must still be verified by fingerprint before they are trusted."
                       Classes="hint" />
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Grid.Column="0" Content="Deny" Classes="danger" HorizontalAlignment="Stretch"
                    MinHeight="46" Click="OnRejectClick" />
            <Button Grid.Column="1" Content="Accept" Classes="primary" HorizontalAlignment="Stretch"
                    MinHeight="46" Click="OnAcceptClick" />
        </Grid>
    </StackPanel>
</Window>
