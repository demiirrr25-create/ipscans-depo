<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IPCast.Client.ViewModels"
        xmlns:conv="using:IPCast.Client.Converters"
        xmlns:persistence="using:IPCast.Client.Persistence"
        x:Class="IPCast.Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="IPCast — Secure Remote Access"
        Icon="/Assets/ipcast.ico"
        Width="1080" Height="760"
        MinWidth="820" MinHeight="560"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
    </Window.Resources>

    <Grid ColumnDefinitions="220,*">

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" Padding="20">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="4,0,4,28">
                    <Image Source="/Assets/ipcast-mark.png" Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,12" AutomationProperties.Name="IPCast logo" />
                    <TextBlock Text="IPCast" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="SECURE REMOTE ACCESS" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <ListBox DockPanel.Dock="Top"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <TextBlock Text="{Binding Label}" FontSize="14" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock DockPanel.Dock="Bottom" Text="1.1 Preview · Auto Relay" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="4" />
            </DockPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">

            <!-- Home -->
            <StackPanel Spacing="20" MaxWidth="760" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        IsVisible="{Binding SelectedNav, Converter={StaticResource EnumEquals}, ConverterParameter=Home}">

                <StackPanel Spacing="6" Margin="0,4,0,4">
                    <TextBlock Text="Remote access, made simple." FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="Share your ID to receive a connection, or enter another device's ID to connect."
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="24">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="YOUR IPCast ID" FontSize="11"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DeviceIdFormatted}" FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Row="1" Grid.Column="1" Content="Copy ID" HorizontalAlignment="Right"
                                Click="OnCopyIdClick" AutomationProperties.Name="Copy your IPCast ID" />
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8"
                                    Margin="0,4,0,0">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LocalConnectionInfo}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding RelayServerMessage}"
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="8" Margin="0,4,0,0">
                            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}" />
                            <TextBlock Text="Unattended access is ON — reachable with ID + password, no click needed"
                                       FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                       IsVisible="{Binding IsUnattendedAccessEnabled}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="CONNECT TO A DEVICE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Remote IPCast ID" FontWeight="SemiBold" />
                        <TextBox Name="RemoteIdTextBox" PlaceholderText="123 456 789" Text="{Binding RemoteIdInput}"
                                 KeyDown="OnRemoteIdKeyDown"
                                 AutomationProperties.Name="Remote device ID or direct IP address and port" />
                        <TextBlock Text="Password (optional, unattended access only)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBox PlaceholderText="Password (only for unattended access)" PasswordChar="*"
                                 AutomationProperties.Name="Unattended access password, optional"
                                 Text="{Binding RemotePasswordInput}" />
                        <Button Content="CONNECT" Classes="primary" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Command="{Binding ConnectCommand}" />
                        <Button Content="Cancel connection" Command="{Binding CancelConnectCommand}" IsVisible="{Binding IsConnecting}" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="10" IsVisible="{Binding DashboardFavoriteDevices.Count}">
                    <TextBlock Text="FAVORITES" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding DashboardFavoriteDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="persistence:FavoriteDevice">
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding FormattedId}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Connect" Classes="primary"
                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ConnectToFavoriteCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="10" IsVisible="{Binding DashboardRecentConnections.Count}">
                    <TextBlock Text="RECENT SESSIONS" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding DashboardRecentConnections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="persistence:ConnectionHistoryEntry">
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                                <Run Text="{Binding RemoteId}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Status}" />
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding Direction}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding DisplayTimestamp}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Connect"
                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ConnectToRecentCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="16" MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        IsVisible="{Binding SelectedNav, Converter={StaticResource EnumEquals}, ConverterParameter=FileTransfer}">
                <TextBlock Text="File Transfer" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Connect to a device with File Transfer permission. The receiver chooses where to save each file." TextWrapping="Wrap" />
                <TextBox Text="{Binding SelectedFilePath}" PlaceholderText="Choose a file or enter its full path" />
                <Button Content="Choose file…" Click="OnChooseFileClick" />
                <Button Content="Send file" Classes="primary" Command="{Binding SendFileCommand}" IsEnabled="{Binding IsConnected}" />
                <Button Content="Cancel transfer" Command="{Binding CancelTransferCommand}" IsVisible="{Binding IsTransferringFile}" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding FileTransferProgress}" />
                <TextBlock Text="{Binding FileTransferMessage}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- My Devices -->
            <StackPanel Spacing="16" MaxWidth="480" HorizontalAlignment="Left" VerticalAlignment="Top"
                        IsVisible="{Binding SelectedNav, Converter={StaticResource EnumEquals}, ConverterParameter=MyDevices}">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Save a device" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox PlaceholderText="Name (e.g. Office PC)" Text="{Binding NewFavoriteName}" />
                        <TextBox PlaceholderText="IPCast ID" Text="{Binding NewFavoriteIdInput}" />
                        <Button Content="Save Device" Classes="primary" HorizontalAlignment="Left"
                                Command="{Binding AddFavoriteCommand}" />
                        <TextBlock Text="{Binding FavoritesMessage}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding FavoriteDevices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="persistence:FavoriteDevice">
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding FormattedId}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="Last connected: " /><Run Text="{Binding LastConnectedDisplay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Connect" Classes="primary" Margin="0,0,6,0"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ConnectToFavoriteCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="2" Content="Remove"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveFavoriteCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Recent Connections -->
            <StackPanel Spacing="12" MaxWidth="480" HorizontalAlignment="Left" VerticalAlignment="Top"
                        IsVisible="{Binding SelectedNav, Converter={StaticResource EnumEquals}, ConverterParameter=RecentConnections}">
                <Button Content="Clear History" HorizontalAlignment="Left" Command="{Binding ClearHistoryCommand}" />
                <TextBlock Text="No connections yet." Foreground="{DynamicResource TextSecondaryBrush}"
                           IsVisible="{Binding !ConnectionHistory.Count}" />
                <ItemsControl ItemsSource="{Binding ConnectionHistory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="persistence:ConnectionHistoryEntry">
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <Run Text="{Binding RemoteId}" /><Run Text=" — " /><Run Text="{Binding Direction}" />
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding DisplayTimestamp}" /><Run Text=" · " /><Run Text="{Binding Status}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Settings -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding SelectedNav, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}">
                <StackPanel Spacing="20" MaxWidth="520" HorizontalAlignment="Left" VerticalAlignment="Top">

                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="24">
                        <StackPanel Spacing="12">
                            <TextBlock Text="General" FontSize="18" FontWeight="Bold" />
                            <CheckBox Content="Start IPCast when I sign in to Windows"
                                      IsChecked="{Binding LaunchAtStartup}"
                                      IsEnabled="{Binding IsLaunchAtStartupSupported}" />
                            <TextBlock Text="Per-user startup setting. No administrator permission is required."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="24">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Display performance" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Choose on the computer being shared. Applies to the next connection. Balanced: everyday work. Speed: slower networks. Quality: sharper text." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding StreamingModes}" SelectedItem="{Binding StreamingMode}" MinHeight="44" HorizontalAlignment="Stretch" AutomationProperties.Name="Screen sharing performance" />
                        </StackPanel>
                    </Border>

                    <!-- Relay Server Settings -->
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="24">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Automatic internet connection" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="IPCast relay is configured automatically. Open this version on both computers, enter the other computer's 9-digit ID and accept the connection on that computer. No relay address or setup code is needed."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding RelayServerMessage}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Unattended Access -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="This device's certificate fingerprint (SHA-256)" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBox Text="{Binding CertificateFingerprint}" IsReadOnly="True" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="24">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Security → Unattended Access" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Let authorized devices connect to this computer using its ID and a password, bypassing the interactive Accept prompt."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Text="Status: ON" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                       IsVisible="{Binding IsUnattendedAccessEnabled}" />
                            <TextBlock Text="Status: OFF" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"
                                       IsVisible="{Binding !IsUnattendedAccessEnabled}" />

                            <TextBox PlaceholderText="New password (min. 8 characters)" PasswordChar="*"
                                     Text="{Binding UnattendedAccessPasswordInput}"
                                     IsVisible="{Binding !IsUnattendedAccessEnabled}" />
                            <Button Content="Enable Unattended Access" Classes="primary" HorizontalAlignment="Left"
                                    Command="{Binding EnableUnattendedAccessCommand}"
                                    IsVisible="{Binding !IsUnattendedAccessEnabled}" />
                            <Button Content="Disable Unattended Access" HorizontalAlignment="Left"
                                    Command="{Binding DisableUnattendedAccessCommand}"
                                    IsVisible="{Binding IsUnattendedAccessEnabled}" />

                            <TextBlock Text="{Binding UnattendedAccessMessage}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Clipboard Sync Option -->
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="24">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Preferences → Clipboard Sync" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <CheckBox Content="Enable automatic bidirectional clipboard sync during connected sessions"
                                      IsChecked="{Binding IsClipboardSyncEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Help -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding SelectedNav, Converter={StaticResource EnumEquals}, ConverterParameter=Help}">
                <StackPanel Spacing="20" MaxWidth="520" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="24">
                        <StackPanel Spacing="12">
                            <TextBlock Text="IPCast Help &amp; Documentation" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="IPCast is a secure remote desktop and file transfer application."
                                       FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Text="1. How to Connect" FontSize="14" FontWeight="Bold" Margin="0,8,0,0"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="To connect to a remote device, ask for its 9-digit IPCast ID (found on their Home screen). Enter the ID in 'Connect to Remote Device' and click CONNECT. You can also connect directly by typing an IP address and port (e.g. 192.168.1.50:9876)."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Text="2. Permissions &amp; Security" FontSize="14" FontWeight="Bold" Margin="0,8,0,0"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="When an incoming connection arrives, an interactive permission dialog appears. The local user can grant or deny specific capabilities: View Screen, Control Mouse, Control Keyboard, Clipboard Sync, and File Transfer."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Text="3. Unattended Access" FontSize="14" FontWeight="Bold" Margin="0,8,0,0"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="To manage remote devices without manual approval, go to Settings -> Security and set an Unattended Access password. Anyone with your 9-digit ID and password will connect instantly."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Text="4. Encryption &amp; Privacy" FontSize="14" FontWeight="Bold" Margin="0,8,0,0"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="All connections are encrypted end-to-end using TLS. No third-party servers see your screen or data."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
