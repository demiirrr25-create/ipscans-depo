<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IPCast.Client.Views.RemoteScreenWindow"
        Title="IPCast - Remote Screen"
        Icon="/Assets/ipcast.ico"
        Width="900" Height="600"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,8" ColumnSpacing="12">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Live view - click/type here to control the remote device (only if it granted control)." />
            <Button Grid.Column="1" Name="FullScreenButton" Content="Full screen" MinHeight="40"
                    Click="OnToggleFullScreenClick" AutomationProperties.Name="Toggle full screen" />
        </Grid>
        <Image Name="ScreenImage" Grid.Row="1" Stretch="Uniform" Focusable="True" AutomationProperties.Name="Remote desktop. Keyboard and pointer control require permission." />
    </Grid>
</Window>
