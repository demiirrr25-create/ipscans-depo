<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IPCast.Client.Views.RemoteScreenWindow"
        Title="IPCast — Remote Screen"
        Icon="/Assets/ipcast.ico"
        Width="1000" Height="660"
        Background="#000000">
    <Grid>
        <Grid RowDefinitions="Auto,*">
            <!-- Collapsible session toolbar (spec §5) -->
            <Border Name="Toolbar" Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusOnlineBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="IPCast" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" Name="MonitorSelector" MinWidth="145"
                              IsVisible="False" SelectionChanged="OnMonitorSelectionChanged"
                              AutomationProperties.Name="Remote monitor" ToolTip.Tip="Choose a remote monitor" />
                    <ComboBox Name="DisplaySelector" MinWidth="125" Margin="8,0"
                              SelectionChanged="OnDisplaySelectionChanged"
                              AutomationProperties.Name="Display scaling" ToolTip.Tip="Choose how the remote image fits this window" />
                    <Button Grid.Column="3" Classes="toolbar" Content="Hide bar" Click="OnToggleToolbarClick"
                            ToolTip.Tip="Hide the toolbar for a cleaner view" AutomationProperties.Name="Hide toolbar" />
                    <Button Grid.Column="4" Name="FullScreenButton" Classes="toolbar" Content="Full screen"
                            Click="OnToggleFullScreenClick" ToolTip.Tip="Toggle full screen (F11)"
                            AutomationProperties.Name="Toggle full screen" />
                    <Button Grid.Column="5" Classes="danger" Content="Disconnect" MinHeight="34" Padding="14,6"
                            Click="OnDisconnectClick" AutomationProperties.Name="Disconnect session" />
                </WrapPanel>
            </Border>

            <ScrollViewer Name="ScreenViewport" Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Image Name="ScreenImage" Stretch="Uniform" StretchDirection="DownOnly" Focusable="True"
                       AutomationProperties.Name="Remote desktop. Keyboard and pointer control require permission." />
            </ScrollViewer>
        </Grid>

        <!-- Floating affordance to restore a hidden toolbar -->
        <Button Name="ShowToolbarButton" Classes="toolbar" Content="▾ Show toolbar"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6,0,0"
                Background="{DynamicResource CardBrushElevated}" IsVisible="False"
                Click="OnToggleToolbarClick" AutomationProperties.Name="Show toolbar" />
    </Grid>
</Window>
