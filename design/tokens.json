  "font": {
    "web": {
      "sans": "'Google Sans Flex', 'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif",
      "mono": "'Google Sans Code', 'Cascadia Mono', Consolas, monospace"
    },
    "desktop": {
      "display": "Segoe UI Variable Display",
      "text": "Segoe UI Variable Text",
      "fallback": "Segoe UI",
      "mono": "Cascadia Mono"
    },
    "size": {
      "xs": 12,
      "sm": 13,
      "md": 14,
      "lg": 16,
      "xl": 20,
      "2xl": 28,
      "3xl": 40,
      "4xl": 56,
      "5xl": 72
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "tracking": {
      "display": "-0.03em",
      "heading": "-0.02em",
      "body": "0",
      "label": "0.02em"
    }
  },
  "space": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96, 128],
  "radius": {
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 22,
    "xl": 28,
    "pill": 999
  },
  "motion": {
    "fast": 150,
    "base": 240,
    "slow": 420,
    "cinematic": 900,
    "easeOut": "cubic-bezier(0.22, 1, 0.36, 1)",
    "easeInOut": "cubic-bezier(0.4, 0, 0.2, 1)",
    "spring": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "elevation": {
    "lightCard": "0 1px 2px rgba(11, 13, 18, 0.04), 0 12px 32px -12px rgba(11, 13, 18, 0.08)",
    "darkCard": "0 0 0 1px #1E222D, 0 16px 40px -16px rgba(0, 0, 0, 0.65)",
    "popover": "0 20px 50px -16px rgba(11, 13, 18, 0.22)"
  },
  "layout": {
    "maxWidth": 1360,
    "gutter": 24,
    "headerHeight": 68,
    "sidebarWidth": 240
  }
}
