{
  "$schema": "https://ipscans.com/design/tokens.schema.json",
  "name": "IPScans Design Tokens",
  "color": {
    "bg": "#000000",
    "surface1": "#0A0A0A",
    "surface2": "#111111",
    "surface3": "#191919",
    "surfaceHover": "#1F1F1F",
    "border": "#1F1F1F",
    "borderStrong": "#2E2E2E",
    "borderFocus": "#FFFFFF",
    "text": "#FFFFFF",
    "textSecondary": "#A1A1A1",
    "textTertiary": "#6E6E6E",
    "textDisabled": "#3D3D3D",
    "accent": "#FFFFFF",
    "accentText": "#000000",
    "chartPrimary": "#FFFFFF",
    "chartSecondary": "#8F8F8F",
    "chartGrid": "#1A1A1A",
    "statusOk": "#46D39A",
    "statusWarn": "#F2C14E",
    "statusError": "#FF6B6B",
    "statusInfo": "#8AB4FF",
    "overlay": "rgba(0,0,0,0.72)"
  },
  "font": {
    "web": {
      "sans": "Geist, 'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif",
      "mono": "'Geist Mono', 'Cascadia Mono', Consolas, monospace"
    },
    "desktop": {
      "display": "Segoe UI Variable Display",
      "text": "Segoe UI Variable Text",
      "fallback": "Segoe UI",
      "mono": "Cascadia Mono"
    },
    "size": { "xs": 12, "sm": 13, "md": 14, "lg": 16, "xl": 20, "2xl": 28, "3xl": 40, "4xl": 56, "5xl": 72 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "tracking": { "display": "-0.03em", "heading": "-0.02em", "body": "0", "label": "0.02em" }
  },
  "space": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96, 128],
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 20, "pill": 999 },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 400,
    "cinematic": 900,
    "easeOut": "cubic-bezier(0.2, 0, 0, 1)",
    "easeInOut": "cubic-bezier(0.4, 0, 0.2, 1)",
    "spring": "cubic-bezier(0.34, 1.3, 0.64, 1)"
  },
  "elevation": {
    "panel": "0 0 0 1px #1F1F1F",
    "popover": "0 0 0 1px #2E2E2E, 0 16px 48px rgba(0,0,0,0.6)"
  },
  "layout": { "maxWidth": 1200, "gutter": 24, "headerHeight": 64, "sidebarWidth": 232 }
}
